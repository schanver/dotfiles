{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "display",
    "shell",
    "wm",
    "terminal",
    "terminalfont",
    "separator",
    "cpu",
    "gpu",
    "memory",
    {
      "type": "disk",
      "folders": [
        {
          "path": "/",
          "name": "Root"
        },
        {
          "path": "/home",
          "name": "Home"
        },
        {
          "path": "/run/media/f/9db850ee-0d5c-4589-aa23-382db5b9bd02",
          "name": "MySSD" 
        }
      ],
      "showType": false,    
      "showMount": false,   
      "percents": true,     
      "barLength": 25       
    },
    "localip",
    "battery",
    "poweradapter",
    //"locale",
    "break",
    "colors"
  ],
    "logo": {
    "source": "~/.config/fastfetch/lain3.txt",
    "type":"file",
    "color": {
      "1":"white"
    }
  }
}
