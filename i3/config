############################################
# bar settings (input comes from i3blocks) #
############################################
bar {
  status_command i3status -c ~/.config/i3status/config
  position top 
  mode dock
  #i3bar_command i3bar --transparency
  tray_output eDP
}

bindsym $mod+m bar mode invisible
bindsym $mod+b bar mode dock

