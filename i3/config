######################################
# color settings for bar and windows #
######################################

set $bg0      #1d2021
set $bg1      #282828
set $bg2      #32302f
set $fg       #ebdbb2
set $gray     #a89984
set $red      #cc241d
set $green    #98971a
set $yellow   #d79921
set $blue     #458588
set $purple   #b16286
set $darkgreen #3c6e47      
set $orange   #d65d0e


# class                 border|backgr|text|indicator|child_border
client.focused          $bg0 $blue      $fg $blue      $blue
client.unfocused        $bg0 $bg2       $gray $bg2     $bg2
client.focused_inactive $bg0 $bg1       $gray $bg1     $bg1
client.urgent           $bg0 $red       $fg $red       $red

smart_borders on
############################################
# bar settings (input comes from i3blocks) #
############################################
bar {
    status_command i3blocks -c ~/.config/i3/i3blocks.conf
    tray_output HDMI-1
    position top
    mode dock

 colors {
        background $bg0
        statusline $fg
        separator $gray

        focused_workspace   $bg0 $blue   $fg
        active_workspace    $bg0 $green  $fg
        inactive_workspace  $bg0 $bg2    $gray
        urgent_workspace    $bg0 $red    $fg
        binding_mode        $bg0 $orange $fg
    }
}

bindsym $mod+m bar mode invisible
bindsym $mod+b bar mode dock

#####################################
