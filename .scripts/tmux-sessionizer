#!/usr/bin/env bash

# --- CONFIG ---
# Define your root directories here:
SEARCH_DIRS=(
  "$HOME/Projects"
  "$HOME/org"
  "$HOME/dotfiles"
  "$HOME/org/ws25-26/sopra"
)

# --- LOGIC ---

# Function: find the project root if we're inside one of the SEARCH_DIRS
find_project_root() {
  local dir="$PWD"
  for root in "${SEARCH_DIRS[@]}"; do
    if [[ "$dir" == "$root"* ]]; then
      # go up until we hit the root subfolder
      while [[ "$dir" != "$root" && ! -d "$dir/.git" && "$dir" != "$HOME" ]]; do
        dir=$(dirname "$dir")
      done
      echo "$dir"
      return
    fi
  done
}

# If a directory was passed as argument, use it
if [[ $# -eq 1 ]]; then
  selected="$1"
else
  # Try to auto-detect project root based on current directory
  selected=$(find_project_root)

  # If not inside a known dir, use fzf to pick one
  if [[ -z "$selected" ]]; then
    selected=$(find "${SEARCH_DIRS[@]}" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | fzf)
  fi
fi

# If user exited fzf or nothing was found
[[ -z "$selected" ]] && exit 0

selected_name=$(basename "$selected" | tr . _)
tmux_running=$(pgrep tmux)

# --- TMUX LOGIC ---
if [[ -z "$TMUX" ]] && [[ -z "$tmux_running" ]]; then
  tmux new-session -s "$selected_name" -c "$selected"
  exit 0
fi

if ! tmux has-session -t="$selected_name" 2>/dev/null; then
  tmux new-session -ds "$selected_name" -c "$selected"
fi

tmux switch-client -t "$selected_name"
