#!/bin/bash

# Check if Timewarrior is tracking
if ! timew | grep -q "Tracking"; then
    exit 0
fi

# Example output:
# Tracking PROGRAMMING
# Started 2025-10-08T15:04:56
# Current 2025-10-08T15:16:22
# Total 0:11:26

# Extract current tag
tag=$(timew | grep "Tracking" | awk '{print $2}')

# Extract elapsed time
elapsed=$(timew | grep "Total" | awk '{print $2}')

# Display
echo "  $tag ($elapsed)"
echo "  $tag ($elapsed)"
echo "#00ff00"
