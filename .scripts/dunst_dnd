#!/usr/bin/env bash

case "$BLOCK_BUTTON" in
    1)  
        dunstctl set-paused toggle
        ;;
    2)  
        dunstctl close-all
        ;;
    3)  # Right click: show last notification
        dunstctl history-pop
        ;;
    4)  # Scroll up: older notifications
        dunstctl history-pop
        ;;
    5)  # Scroll down: close current
        dunstctl close
        ;;
esac

if dunstctl is-paused | grep -q true; then
    echo "  "
    echo "DND enabled | L:toggle R:history M:clear"
    echo "#ff5555"
else
    echo "  "
    echo "Notifications enabled | L:toggle R:history M:clear"
    echo "#50fa7b"
fi
