#!/bin/bash

# Path to the state file
STATE_FILE="$HOME/.cache/i3blocks_clock_state"

# Function to refresh i3blocks
refresh_block() {
    # Send a signal to the current block only if possible
    pkill -RTMIN+10 i3blocks
}

# Mouse click handling
case "$BLOCK_BUTTON" in
    1)  # Left click: toggle between date and time
        if [[ -f "$STATE_FILE" ]]; then
            rm -f "$STATE_FILE"
        else
            touch "$STATE_FILE"
        fi
        refresh_block
        exit 0
        ;;
    2)  # Middle click: reset to time
        rm -f "$STATE_FILE"
        refresh_block
        exit 0
        ;;
    3)  # Right click: open calendar
        if command -v gnome-calendar &>/dev/null; then
            nohup gnome-calendar >/dev/null 2>&1 &
        elif command -v cal &>/dev/null; then
            gnome-terminal -- bash -c "cal; exec bash"
        else
            notify-send "No calendar app found"
        fi
        ;;
esac

# Display output
if [[ -f "$STATE_FILE" ]]; then
    # Show date according to locale
    echo "📅 $(date +'%x')"  # %x = locale's date format
else
    # Show time (with optional seconds)
    echo "🕒 $(date +'%H:%M')"
fi

exit 0
